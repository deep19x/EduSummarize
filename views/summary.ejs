<% layout('layouts/boilerplate') %>

    <div class="container mt-5 pt-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: #fe424d;">Upload & Summarize PDF</h2>
            <p class="text-muted">Select your study material, and our AI will generate a clear and concise summary for
                you.</p>
        </div>

        <!-- Upload Form -->
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm p-4">
                    <form action="/summary" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="pdfFile" class="form-label fw-semibold">Select PDF File</label>
                            <input class="form-control" type="file" name="pdfFile" id="pdfFile" accept=".pdf"
                                required />
                        </div>
                        <div class="d-grid">
                            <button class="btn text-white" style="background-color: #fe424d;">
                                Generate Summary
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Summary Output -->
        <% if (summary) { %>
            <div class="row justify-content-center mt-5">
                <div class="col-md-10">
                    <div class="card shadow-sm border-0 p-4">
                        <h4 class="mb-3 fw-semibold" style="color: #fe424d;">Generated Summary</h4>
                        <p style="white-space: pre-line; line-height: 1.7;">
                            <%= summary %>
                        </p>
                    </div>
                </div>
            </div>
            <% } %>
    </div>