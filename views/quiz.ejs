<% layout('layouts/boilerplate') %>

    <div class="container mt-5 pt-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: #fe424d;">Quiz</h2>
            <p class="text-muted">Test your understanding from your most recently uploaded PDF summary.</p>
        </div>

        <!-- Message when no upload exists -->
        <% if (message) { %>
            <div class="alert alert-warning text-center">
                <%= message %>
            </div>
            <% } %>

                <!-- Quiz Questions -->
                <% if (questions && questions.length> 0) { %>
                    <form action="/quiz/submit" method="POST" class="row justify-content-center">
                        <div class="col-md-10">
                            <% questions.forEach((q, index)=> { %>
                                <div class="card border-0 shadow-sm mb-4 p-3">
                                    <div class="card-body">
                                        <h6 class="fw-bold mb-3" style="color: #fe424d;">Q<%= index + 1 %>. <%=
                                                    q.question %>
                                        </h6>
                                        <% q.options.forEach((option, optIndex)=> { %>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="answer<%= index %>"
                                                    id="q<%= index %>opt<%= optIndex %>" value="<%= option %>"
                                                    required />
                                                <label class="form-check-label" for="q<%= index %>opt<%= optIndex %>">
                                                    <%= option %>
                                                </label>
                                            </div>
                                            <% }); %>
                                    </div>
                                </div>
                                <% }); %>
                                    <div class="text-center mt-4">
                                        <button class="btn text-white px-4" style="background-color: #fe424d;">Submit
                                            Quiz</button>
                                    </div>
                        </div>
                    </form>
                    <% } %>

                        <!-- Quiz Results -->
                        <% if (score !==undefined) { %>
                            <div class="row justify-content-center mt-5">
                                <div class="col-md-6 text-center">
                                    <div class="card border-0 shadow-sm p-4">
                                        <h4 class="fw-bold" style="color: #fe424d;">Quiz Completed!</h4>
                                        <p class="mt-3">You scored <strong>
                                                <%= score %>
                                            </strong> out of <strong>
                                                <%= total %>
                                            </strong>.</p>
                                        <a href="/dashboard" class="btn text-white mt-3"
                                            style="background-color: #fe424d;">Back to Dashboard</a>
                                    </div>
                                </div>
                            </div>
                            <% } %>
    </div>