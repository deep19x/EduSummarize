<% layout('layouts/boilerplate') %>

    <div class="container mt-5 pt-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold" style="color: #fe424d;">Flashcards</h2>
            <p class="text-muted">Auto-generated from your most recently uploaded PDF summary.</p>
        </div>

        <!-- Message when no upload exists -->
        <% if (message) { %>
            <div class="alert alert-warning text-center">
                <%= message %>
            </div>
            <% } %>

                <!-- Flashcards Display -->
                <% if (flashcards && flashcards.length> 0) { %>
                    <div class="row justify-content-center mt-4">
                        <h5 class="text-center mb-4 fw-semibold" style="color: #fe424d;">Generated Flashcards</h5>

                        <% flashcards.forEach((card, index)=> { %>
                            <div class="col-md-4 mb-3">
                                <div class="card border-0 shadow-sm h-100 p-3">
                                    <div class="card-body text-center">
                                        <h6 class="fw-bold">Q<%= index + 1 %>:</h6>
                                        <p>
                                            <%= card.question %>
                                        </p>
                                        <button class="btn btn-outline-danger mt-2" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#answer<%= index %>">
                                            Show Answer
                                        </button>
                                        <div class="collapse mt-2" id="answer<%= index %>">
                                            <div class="alert alert-light border">
                                                <%= card.answer %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
    </div>