<style>
    /* Color Palette Variables (Optional, but recommended for large projects) */
    :root {
        --primary-color: #fe424d; /* Reddish-Pink */
        --primary-hover: #e73c46;
        --text-dark: #333;
        --bg-light: #fff;
        --shadow-light: rgba(0, 0, 0, 0.1);
    }

    /* Navbar Container */
    .navbar {
        background-color: var(--bg-light);
        box-shadow: 0 2px 8px var(--shadow-light); /* Slightly deeper shadow */
        padding: 0.5rem 1rem; /* Add a little vertical padding */
    }

    /* Navbar Brand/Logo */
    .navbar-brand {
        font-weight: 700;
        font-size: 1.5rem; /* Slightly larger for emphasis */
        color: var(--primary-color) !important; /* Ensure primary color dominance */
        transition: 0.2s ease-in-out;
    }
    .navbar-brand:hover {
        opacity: 0.85; /* Subtle hover effect */
    }

    /* Regular Navigation Links */
    .nav-link {
        font-weight: 500;
        color: var(--text-dark); /* Ensure standard link color */
        transition: color 0.2s ease-in-out;
    }

    .nav-link:hover {
        color: var(--primary-color) !important;
    }
    
    /* Active Link Styling (Optional, assumes Bootstrap 'active' class is used) */
    .nav-link.active {
        color: var(--primary-color) !important;
        border-bottom: 2px solid var(--primary-color);
        padding-bottom: 0.3rem;
    }


    /* Primary Button Style */
    .btn-main {
        background-color: var(--primary-color);
        color: var(--bg-light) !important; /* Make sure text is white */
        border: 1px solid var(--primary-color);
        border-radius: 50px; /* Use a full pill shape for buttons */
        padding: 0.35rem 1.25rem; /* Slightly more padding for better click area */
        font-weight: 600;
        text-transform: none; /* Keep text natural case */
        transition: all 0.2s ease-in-out;
    }

    .btn-main:hover {
        background-color: var(--primary-hover);
        border-color: var(--primary-hover);
        color: var(--bg-light) !important;
        transform: translateY(-1px); /* Subtle lift effect */
    }

    /* Secondary Button Style (For 'Login' when 'Sign Up' is primary) */
    /* I recommend making 'Login' secondary so 'Sign Up' stands out more */
    .btn-secondary-outline {
        background-color: transparent;
        color: var(--primary-color) !important;
        border: 1px solid var(--primary-color);
        border-radius: 50px;
        padding: 0.35rem 1.25rem;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }

    .btn-secondary-outline:hover {
        background-color: var(--primary-color);
        color: var(--bg-light) !important;
    }

    /* Disabled/Welcome Text */
    .nav-link.disabled {
        color: #6c757d !important; /* Muted gray for disabled text */
        font-weight: 400;
    }
</style>

<nav class="navbar navbar-expand-md fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">
            <i class="fa-solid fa-book-open-reader"></i> EDU-Summarize
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard">Dashboard</a> 
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/flashcards">Flashcards</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/quiz">Quiz</a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                <% if (!currentUser) { %>
                    <li class="nav-item mx-1">
                        <a class="nav-link btn-main" href="/register">Sign Up</a> 
                    </li>
                    <li class="nav-item mx-1">
                        <a class="nav-link btn-secondary-outline" href="/login">Login</a> 
                    </li>
                    <% } else { %>
                        <li class="nav-item d-flex align-items-center me-2">
                            <span class="nav-link disabled">Hi, <%= currentUser.username %>!</span>
                        </li>
                        <li class="nav-item mx-1">
                            <a class="nav-link btn-main" href="/logout">Sign Out</a> 
                        </li>
                        <% } %>
            </ul>
        </div>
    </div>
</nav>